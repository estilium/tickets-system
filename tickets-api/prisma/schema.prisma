// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  AGENT
  CHECKLIST_MANAGER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String?  @unique
  name         String
  password     String
  role         Role     @default(REQUESTER)
  assignedArea String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedTickets Ticket[] @relation("TicketAssignedTo")



  ticketsRequested Ticket[]
  messages         TicketMessage[]
  checklistRuns    ChecklistRun[]
  maintenanceRuns  MaintenanceRun[]
  announcements    Announcement[]
  inventoryEvents  InventoryEvent[]
}

model Ticket {
  id          String       @id @default(uuid())
  title       String
  description String
  ticketLocation    String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(NORMAL)
  closedAt DateTime?


  requester   User   @relation(fields: [requesterId], references: [id])
  requesterId String

  messages TicketMessage[]
  
  attachments TicketAttachment[]

  assignedToId String?
  assignedTo   User? @relation("TicketAssignedTo", fields: [assignedToId], references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketMessage {
  id      String @id @default(uuid())
  content String

  ticket   Ticket @relation(fields: [ticketId], references: [id])
  ticketId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  createdAt DateTime @default(now())
  attachments TicketAttachment[]
}

model Category {
  id    String  @id @default(uuid())
  name  String
  nameEn String?
  nameKr String?
  order Int     @default(0)
  tickets Ticket[]
}

model TicketLocation {
  id    String @id @default(uuid())
  name  String @unique
  nameEn String?
  nameKr String?
  order Int    @default(0)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

model TicketAttachment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  messageId String?
  message   TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  filename  String
  original  String
  mime      String
  size      Int
  url       String

  createdAt DateTime @default(now())

  @@index([messageId])
}

model MonthlyMttrRecord {
  id              String   @id @default(uuid())
  year            Int
  month           Int
  totalClosed     Int
  mttrMinutesAvg  Float
  mttrMinutesMin  Float
  mttrMinutesMax  Float
  from            DateTime
  to              DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([year, month], name: "year_month")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  active    Boolean  @default(true)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([createdAt])
}

enum ChecklistShift {
  SHIFT_1
  SHIFT_2
}

enum ChecklistItemStatus {
  OK
  NG
}

model ChecklistMachine {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  area        String?
  category    String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  maintenanceEnabled Boolean @default(false)
  maintenanceFrequencyMonths Int @default(2)
  maintenanceStartMonth Int?
  maintenanceType String? @default("Preventivo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ChecklistItem[]
  runs  ChecklistRun[]
  maintenanceRuns MaintenanceRun[]
  inventoryAssets InventoryAsset[]
}

enum AssetType {
  DESKTOP
  LAPTOP
  AIO
  MONITOR
  PPC
  PDA
  PRINTER
  ACCESSORY
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  ACTIVE
  MAINTENANCE
  LOST
  DISPOSED
}

enum AssetCondition {
  GOOD
  FAIR
  DAMAGED
  UNKNOWN
}

model InventoryAsset {
  id          String         @id @default(uuid())
  assetTag    String?        @unique
  assetTypeId String?
  assetType   InventoryAssetType? @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)
  type        AssetType      @default(OTHER)
  status      AssetStatus    @default(AVAILABLE)
  condition   AssetCondition @default(UNKNOWN)
  department  String?
  location    String?
  assignedTo  String?
  assignedEmail String?
  brand       String?
  model       String?
  serialNumber String?       @unique
  os          String?
  ram         String?
  ipAddress   String?
  quantity    Int            @default(1)
  notes       String?
  customFields Json          @default("{}")
  maintenanceEligible Boolean @default(false)
  checklistMachineId String?
  checklistMachine ChecklistMachine? @relation(fields: [checklistMachineId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  events InventoryEvent[]

  @@index([type])
  @@index([assetTypeId])
  @@index([status])
  @@index([department])
  @@index([assignedTo])
  @@index([checklistMachineId])
}

model InventoryAssetType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  labelPrefix String   @unique
  baseType    AssetType @default(OTHER)
  description String?
  criteria    Json     @default("[]")
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets InventoryAsset[]

  @@index([active])
  @@index([baseType])
  @@index([order])
}

model InventoryBrand {
  id        String   @id @default(uuid())
  name      String   @unique
  appliesTo Json     @default("[]")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}

model InventoryEvent {
  id        String   @id @default(uuid())
  assetId   String
  asset     InventoryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([actorId])
  @@index([createdAt])
}

model ChecklistItem {
  id          String   @id @default(uuid())
  machineId   String
  machine     ChecklistMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  label       String
  description String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses ChecklistResponse[]

  @@index([machineId])
}

model ChecklistRun {
  id          String         @id @default(uuid())
  machineId   String
  machine     ChecklistMachine @relation(fields: [machineId], references: [id])
  agentId     String
  agent       User           @relation(fields: [agentId], references: [id])
  date        DateTime
  shift       ChecklistShift
  status      String         @default("COMPLETED")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  responses ChecklistResponse[]

  @@unique([machineId, date, shift])
  @@index([date])
  @@index([agentId])
}

model ChecklistResponse {
  id          String              @id @default(uuid())
  runId       String
  run         ChecklistRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId      String
  item        ChecklistItem        @relation(fields: [itemId], references: [id])
  status      ChecklistItemStatus
  observation String?
  createdAt   DateTime            @default(now())

  @@unique([runId, itemId])
  @@index([itemId])
}

enum MaintenanceStatus {
  OK
  NG
}

model MaintenanceRun {
  id          String            @id @default(uuid())
  machineId   String
  machine     ChecklistMachine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  agentId     String
  agent       User              @relation(fields: [agentId], references: [id])
  year        Int
  month       Int
  status      MaintenanceStatus
  observation String?
  completedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([machineId, year, month])
  @@index([year, month])
  @@index([agentId])
}
